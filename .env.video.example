# Copy desired values into your server environment; this file is not loaded automatically.
# Existing directory only. On Linux an explicitly mounted external filesystem is required.
VIDEO_STORAGE_DIR=/mnt/sda1/linai/videos
VIDEO_STORAGE_MOUNT=/mnt/sda1
VIDEO_RETRIEVAL_CONCURRENCY=1
VIDEO_MAX_FILE_BYTES=1073741824
VIDEO_MIN_FREE_BYTES=134217728
VIDEO_TRANSFER_TIMEOUT_MS=1800000
VIDEO_GENERATION_TIMEOUT_MS=21600000
# Optional exact browser origin when TLS terminates at an authenticated reverse proxy.
# VIDEO_PUBLIC_ORIGIN=https://linai.example.com

# Exact hostnames, comma separated, including redirect CDN hosts. No wildcards/IP literals.
# Empty by default: fail closed for remote media access.
VIDEO_ALLOWED_HOSTS=

# Optional simulator ONLY. Use a public HTTPS MP4/WebM file you control and allow its hostname above.
# Mock does not generate new videos; it simulates an asynchronous task returning this test file.
VIDEO_MOCK_RESULT_URL=
